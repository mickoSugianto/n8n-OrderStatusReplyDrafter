{
  "name": "RecoverOrderStatusRequest",
  "nodes": [
    {
      "id": "rec-schedule-recovery-sweep",
      "name": "ScheduleRecoverySweep",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "5de2347e-e2fa-4cfe-96e8-f1405da90a6c",
      "name": "StartRecovery",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        224
      ],
      "parameters": {}
    },
    {
      "id": "f04a207c-5c5c-4448-a6eb-e6355aee507c",
      "name": "SelectUnresolvedRequest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        320,
        112
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "req-mode",
              "name": "mode",
              "value": "={{ $('ScheduleRecoverySweep').isExecuted ? 'auto' : 'manual' }}",
              "type": "string"
            },
            {
              "id": "req-receiver-email",
              "name": "receiverEmail",
              "value": "controlled-receiver@example.com",
              "type": "string"
            },
            {
              "id": "req-cooldown-seconds",
              "name": "cooldownSeconds",
              "value": 300,
              "type": "number"
            },
            {
              "id": "req-batch-limit",
              "name": "batchLimit",
              "value": 5,
              "type": "number"
            },
            {
              "id": "req-settle-window-ms",
              "name": "settleWindowMs",
              "value": 60000,
              "type": "number"
            },
            {
              "id": "req-source-message-id",
              "name": "sourceMessageId",
              "value": "",
              "type": "string"
            },
            {
              "id": "req-expected-owner-token",
              "name": "expectedOwnerToken",
              "value": "",
              "type": "string"
            },
            {
              "id": "req-writes-settled",
              "name": "writesSettled",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "req-note",
              "name": "note",
              "value": "",
              "type": "string"
            },
            {
              "id": "req-accept-changed-version",
              "name": "acceptChangedVersion",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "req-inspected-draft-id",
              "name": "inspectedDraftId",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "Centralized recovery configuration: set receiverEmail, cooldownSeconds, batchLimit, and settleWindowMs for automated sweeps, or fill sourceMessageId, expectedOwnerToken, writesSettled, note, acceptChangedVersion, and inspectedDraftId for manual recovery."
    },
    {
      "id": "rec-route-recovery-mode",
      "name": "RouteRecoveryMode",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        640,
        112
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-mode-is-auto",
              "leftValue": "={{ $('SelectUnresolvedRequest').item.json.mode === 'auto' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "rec-find-recoverable-requests",
      "name": "FindRecoverableRequests",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        960,
        0
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT value AS record FROM jsonb_array_elements(public.find_recoverable_order_status_requests($1::jsonb))",
        "options": {
          "queryReplacement": "={{ [JSON.stringify({mailbox: $('SelectUnresolvedRequest').item.json.receiverEmail, cooldown_seconds: $('SelectUnresolvedRequest').item.json.cooldownSeconds, limit: $('SelectUnresolvedRequest').item.json.batchLimit})] }}",
          "connectionTimeout": 15,
          "queryBatching": "independently"
        }
      },
      "retryOnFail": false
    },
    {
      "id": "rec-build-auto-recovery-requests",
      "name": "BuildAutoRecoveryRequests",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1280,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "auto-req-mode",
              "name": "mode",
              "value": "auto",
              "type": "string"
            },
            {
              "id": "auto-req-source-message-id",
              "name": "sourceMessageId",
              "value": "={{ $json.record.source_message_id }}",
              "type": "string"
            },
            {
              "id": "auto-req-expected-owner-token",
              "name": "expectedOwnerToken",
              "value": "={{ $json.record.owner_token }}",
              "type": "string"
            },
            {
              "id": "auto-req-settle-window-ms",
              "name": "settleWindowMs",
              "value": "={{ $('SelectUnresolvedRequest').item.json.settleWindowMs }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6807d7e8-2ae2-46b0-bf2e-1def235a93aa",
      "name": "RecoverThroughMain",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        1600,
        112
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "<MAIN_WORKFLOW_ID>"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "request": "={{ $json }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "request",
              "displayName": "request",
              "type": "object",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "8dc6ad47-28f9-4bd4-b0c0-7e0db35c530c",
      "name": "ReturnRecoveryOutcome",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ $json }}",
        "options": {}
      }
    },
    {
      "id": "rec-verify-sweep-batch-outcome",
      "name": "VerifySweepBatchOutcome",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1920,
        224
      ],
      "parameters": {
        "errorMessage": "={{ JSON.stringify($json) }}"
      }
    },
    {
      "id": "fc465c94-8606-4364-bba0-bcb1299476fd",
      "name": "RecoveryTriggerLane",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -64,
        -144
      ],
      "parameters": {
        "content": "## 01 — Trigger & configure recovery\nRun on the 5-minute automated sweep or manually with operator-supplied ledger evidence. Configure mailbox, cooldown, batch limit, and manual override fields in SelectUnresolvedRequest.",
        "width": 928,
        "height": 544,
        "color": 4
      }
    },
    {
      "id": "rec-dispatch-lane-note",
      "name": "RecoveryDispatchLane",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        896,
        -144
      ],
      "parameters": {
        "content": "## 02 — Discover & dispatch recovery batch\nQuery read-only recoverable ledger rows after cooldown, build auto-recovery envelopes, and dispatch both automated and manual requests through the shared RecoverThroughMain node.",
        "width": 1248,
        "height": 544,
        "color": 5
      }
    }
  ],
  "connections": {
